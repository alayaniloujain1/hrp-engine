{
  "name": "HRP weekly rebalance",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            { "field": "cronExpression", "expression": "0 7 * * 1" }
          ]
        }
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000001",
      "name": "Weekly cron (Mon 07:00)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://hrp-api:8000/api/data/refresh",
        "sendHeaders": true,
        "headerParameters": { "parameters": [ { "name": "X-API-Key", "value": "change-me" } ] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{ \"lookback_days\": 504 }",
        "options": {}
      },
      "id": "a1b2c3d4-0002-4000-8000-000000000002",
      "name": "Pull multi-asset returns",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://hrp-api:8000/api/rebalance",
        "sendHeaders": true,
        "headerParameters": { "parameters": [ { "name": "X-API-Key", "value": "change-me" } ] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{ \"lookback_days\": 504, \"linkage\": \"single\", \"cov_method\": \"sample\", \"threshold_pct\": 3, \"notify\": false }",
        "options": { "timeout": 120000 }
      },
      "id": "a1b2c3d4-0003-4000-8000-000000000003",
      "name": "FastAPI HRP dendrogram optimizer",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2 },
          "conditions": [
            {
              "id": "b1c2d3e4-0001-4000-8000-000000000001",
              "leftValue": "={{ $json.triggered }}",
              "rightValue": "",
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1b2c3d4-0004-4000-8000-000000000004",
      "name": "IF weight drift > 3%",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [720, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://hrp-api:8000/api/rebalance/csv",
        "sendHeaders": true,
        "headerParameters": { "parameters": [ { "name": "X-API-Key", "value": "change-me" } ] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{ \"lookback_days\": 504, \"linkage\": \"single\", \"cov_method\": \"sample\", \"threshold_pct\": 3 }",
        "options": {
          "response": { "response": { "responseFormat": "file", "outputPropertyName": "basket" } }
        }
      },
      "id": "a1b2c3d4-0005-4000-8000-000000000005",
      "name": "Generate trade basket CSV",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [980, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://example.com/manager-webhook",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ event: 'hrp.rebalance.required', as_of: $('FastAPI HRP dendrogram optimizer').item.json.optimization.as_of, max_drift_pp: $('FastAPI HRP dendrogram optimizer').item.json.max_drift_pp, breaches: $('FastAPI HRP dendrogram optimizer').item.json.breaches, turnover_pct: $('FastAPI HRP dendrogram optimizer').item.json.turnover_pct, trades: $('FastAPI HRP dendrogram optimizer').item.json.trades, csv: $('FastAPI HRP dendrogram optimizer').item.json.csv }) }}",
        "options": {}
      },
      "id": "a1b2c3d4-0006-4000-8000-000000000006",
      "name": "Manager webhook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [980, 400]
    },
    {
      "parameters": {},
      "id": "a1b2c3d4-0007-4000-8000-000000000007",
      "name": "Within tolerance (no action)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [980, 580]
    }
  ],
  "connections": {
    "Weekly cron (Mon 07:00)": { "main": [ [ { "node": "Pull multi-asset returns", "type": "main", "index": 0 } ] ] },
    "Pull multi-asset returns": { "main": [ [ { "node": "FastAPI HRP dendrogram optimizer", "type": "main", "index": 0 } ] ] },
    "FastAPI HRP dendrogram optimizer": { "main": [ [ { "node": "IF weight drift > 3%", "type": "main", "index": 0 } ] ] },
    "IF weight drift > 3%": {
      "main": [
        [
          { "node": "Generate trade basket CSV", "type": "main", "index": 0 },
          { "node": "Manager webhook", "type": "main", "index": 0 }
        ],
        [ { "node": "Within tolerance (no action)", "type": "main", "index": 0 } ]
      ]
    }
  },
  "settings": { "executionOrder": "v1" }
}
