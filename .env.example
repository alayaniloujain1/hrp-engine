# Require this key on every /api call (except /api/health). Leave empty to disable auth.
API_KEY=
# Default manager webhook used when a request sets notify=true without webhook_url.
MANAGER_WEBHOOK_URL=
# If set, webhook bodies are signed: X-HRP-Signature: sha256=<hmac of body>
WEBHOOK_SECRET=
# auto = yfinance with synthetic fallback | yfinance = strict | synthetic = offline demo data
HRP_DATA_SOURCE=auto
HRP_CACHE_TTL=900
